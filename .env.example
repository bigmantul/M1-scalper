# Deriv credentials (same PAT + App ID the old bot used)
DERIV_PAT_TOKEN=pat_your_token_here
DERIV_APP_ID=your_app_id_here

# Dashboard login — REQUIRED (min 8 chars). The dashboard can place trades.
DASHBOARD_PASSWORD=change-me-please

# Network: localhost only by default. Use 0.0.0.0 when deploying (e.g. Render) and keep the password strong.
PORT=3000
HOST=127.0.0.1

# Real-money trading stays locked until you set this to true. Leave it out while testing on demo.
# ALLOW_REAL=true

# Where settings, state, trades and logs are stored (use a persistent disk when deploying)
# DATA_DIR=./data
